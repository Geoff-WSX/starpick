# 密钥与环境
.env
*.env.local

# 数据与日志
backend/history.db
backend/history.db-*
backend/history.db.*
backend/data/
logs/
*.log
*.log.*

# 运行时 Token（设置页保存、热生效；绝不提交）
backend/.runtime_token

# 前端构建产物与依赖
frontend/node_modules/
frontend/dist/

# TypeScript 增量编译产物（vue-tsc -b 生成，可由源码重建）
*.tsbuildinfo
frontend/vite.config.js
frontend/vite.config.d.ts

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# 编辑器
.idea/
.vscode/
.DS_Store

# 打包（packaging/）：构建中间产物与打包用 venv；图标 icon.icns/icon.ico 入库
packaging/.venv-build/
packaging/build/
packaging/dist/
packaging/icon-preview*.png
